     if(!dc) return GDI_ERROR;
 
     dev = GET_DC_PHYSDEV( dc, pGetGlyphOutline );
-    ret = dev->funcs->pGetGlyphOutline( dev, ch & 0xffff, format, metrics, size, buffer, mat2 );
+    /* Masked to 16 bits only when it is a character, and only within the BMP.
+     * The mask is there because a caller may pass a full WCHAR with rubbish in
+     * the high half, but applied to everything it also throws away the top of
+     * an astral codepoint -- U+1F33E arrives as U+F33E, which no font has, so
+     * the glyph comes back as the missing one. That is the last step of the
+     * path a surrogate pair travels: composed by the caller, looked up here,
+     * and until now truncated in between.
+     *
+     * Not under GGO_GLYPH_INDEX, where ch is a glyph number and its width is
+     * the font's business rather than Unicode's. */
+    if ((format & GGO_GLYPH_INDEX) || ch < 0x10000 || ch > 0x10ffff) ch &= 0xffff;
+    ret = dev->funcs->pGetGlyphOutline( dev, ch, format, metrics, size, buffer, mat2 );
     release_dc_ptr( dc );
     return ret;
 }

+/*****************************************************************
+ *		WAYLAND_ActivateWindow
+ *
+ * 창이 자기를 앞으로 내달라고 한다. Wayland에서 그것을 하는 것이
+ * xdg-activation이다. 컴포지터에서 토큰을 받고, 그 토큰을 가진 쪽이
+ * 표면을 올릴 수 있다. 마지막 입력 시리얼을 붙이는데, 이 요청이
+ * 사용자가 한 일을 따라온 것이라고 컴포지터에게 말하는 것이 그것이다.
+ * 시리얼이 없거나 오래되었으면 컴포지터는 창을 올리는 대신 표시만
+ * 해도 되고, mutter는 정확히 그렇게 한다.
+ */
+/* 요청한 창. 토큰은 왕복 하나만큼 늦게 오고, 그 사이에 포그라운드가
+ * 바뀌어 있을 수 있다. 그때 낡은 토큰으로 표면을 올리면 컴포지터의
+ * 포커스를 이미 지나간 창으로 끌고 간다.
+ *
+ * 트레이 메뉴가 그렇게 죽었다. 메뉴 창은 포그라운드가 되었다가 곧 닫히고,
+ * 닫힌 뒤에 도착한 토큰이 포커스를 그리로 되돌리면 메뉴 루프가 잡고 있던
+ * 캡처가 풀린다. 토큰이 루프보다 먼저 오면 멀쩡하고 늦게 오면 죽어서,
+ * 증상이 그때그때 달랐다.
+ *
+ * X11 드라이버에는 이 문제가 없다. 왕복 없이 _NET_ACTIVE_WINDOW를 그
+ * 자리에서 보낸다. 다만 거기도 이미 요청한 창에는 다시 요청하지 않는다.
+ * set_net_active_window의 pending_state 검사가 그것이다. */
+static void *activation_hwnd;
+
+static void activation_token_handle_done(void *private,
+                                         struct xdg_activation_token_v1 *token,
+                                         const char *token_string)
+{
+    HWND hwnd = private;
+    struct wayland_win_data *data;
+    struct wayland_surface *surface;
+
+    TRACE("hwnd=%p token=%s\n", hwnd, debugstr_a(token_string));
+
+    /* 뒤에 다른 요청이 있었으면 이것은 버린다. 검사와 동시에 비운다. */
+    if (InterlockedCompareExchangePointer(&activation_hwnd, NULL, hwnd) != hwnd)
+    {
+        TRACE("superseded, dropping the token\n");
+        goto done;
+    }
+
+    /* 요청은 그대로인데 포그라운드만 옮겨간 경우. 앞의 검사에 안 걸린다. */
+    if (NtUserGetForegroundWindow() != hwnd)
+    {
+        TRACE("no longer in the foreground, dropping the token\n");
+        goto done;
+    }
+
+    if ((data = wayland_win_data_get(hwnd)))
+    {
+        if ((surface = data->wayland_surface) && wayland_surface_is_toplevel(surface))
+        {
+            xdg_activation_v1_activate(process_wayland.xdg_activation_v1,
+                                       token_string, surface->wl_surface);
+            wl_display_flush(process_wayland.wl_display);
+        }
+        wayland_win_data_release(data);
+    }
+
+done:
+    xdg_activation_token_v1_destroy(token);
+}
+
+static const struct xdg_activation_token_v1_listener activation_token_listener =
+{
+    activation_token_handle_done
+};
+
+void WAYLAND_ActivateWindow(HWND hwnd, HWND previous)
+{
+    struct xdg_activation_token_v1 *token;
+    struct wayland_win_data *data;
+    struct wayland_surface *surface;
+
+    TRACE("hwnd=%p previous=%p\n", hwnd, previous);
+
+    if (!process_wayland.xdg_activation_v1) return;
+    if (!(data = wayland_win_data_get(hwnd))) return;
+
+    if ((surface = data->wayland_surface) && wayland_surface_is_toplevel(surface))
+    {
+        /* 앞의 요청이 아직 답을 기다리고 있으면 그것을 버리게 한다. */
+        InterlockedExchangePointer(&activation_hwnd, hwnd);
+
+        token = xdg_activation_v1_get_activation_token(process_wayland.xdg_activation_v1);
+        xdg_activation_token_v1_add_listener(token, &activation_token_listener, hwnd);
+
+        pthread_mutex_lock(&process_wayland.seat.mutex);
+        if (process_wayland.seat.wl_seat)
+        {
+            xdg_activation_token_v1_set_serial(token, process_wayland.input_serial,
+                                               process_wayland.seat.wl_seat);
+        }
+        pthread_mutex_unlock(&process_wayland.seat.mutex);
+
+        if (process_name) xdg_activation_token_v1_set_app_id(token, process_name);
+        xdg_activation_token_v1_set_surface(token, surface->wl_surface);
+        xdg_activation_token_v1_commit(token);
+        wl_display_flush(process_wayland.wl_display);
+    }
+
+    wayland_win_data_release(data);
+}
+
 static enum xdg_toplevel_resize_edge hittest_to_resize_edge(WPARAM hittest)
 {
     switch (hittest)
diff --git a/dlls/winewayland.drv/xdg-activation-v1.xml b/dlls/winewayland.drv/xdg-activation-v1.xml

+/* 진짜 입력이 왔다고 기록한다. 포커스가 들고 나는 것은 입력이 아니므로
+ * enter와 leave에서는 부르지 않는다. */
+static inline void wayland_note_input(void)
+{
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    /* InterlockedExchange64가 아닌 이유는 winnt.h의 그것이 유닉스 쪽에서
+     * 빌드되지 않기 때문이다. _InterlockedExchange64를 찾는다. */
+    __atomic_store_n(&process_wayland.input_time,
+                     (LONG64)now.tv_sec * 1000 + now.tv_nsec / 1000000,
+                     __ATOMIC_RELAXED);
+}

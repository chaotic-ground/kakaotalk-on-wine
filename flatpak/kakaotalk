#!/bin/bash
# 프리픽스가 없으면 만들고, 카카오톡을 실행한다.
#
# 설치 파일이 돌기 전에 네 가지가 한국어여야 하고, 빠지면 각각 다르게
# 조용히 실패한다. 런타임 로캘, wine을 위한 LC_ALL, 레지스트리의 윈도우 UI
# 언어, 그리고 프리픽스 안의 한국어 글꼴이다. 카카오톡은 설치하면서 UI
# 언어를 한 번만 읽으므로, 영어 프리픽스에 설치된 클라이언트는 영영
# 영어다.
#
#   kakaotalk              필요하면 준비하고 실행
#   kakaotalk --reinstall  클라이언트를 그 위에 다시 설치
#   kakaotalk --setup      준비만 하고 실행은 안 함
#   kakaotalk --restart    돌고 있는 클라이언트를 끄고 그 자리를 차지
#   kakaotalk --quit       돌고 있는 클라이언트에 닫으라고 요청
#   kakaotalk --show       숨은 창을 불러옴
#   kakaotalk --menu       앱 자신의 트레이 메뉴를 띄움
#   kakaotalk --menu-close 그걸 닫음
set -euo pipefail
IFS=$'\n\t'

# $HOME이 아니다. 샌드박스 안에서 $HOME은 진짜 경로지만 그 안에 있는 것은
# 거의 없고, 거기 쓴 것은 살아남지 않는다. 남는 것은 앱 자신의 데이터
# 디렉터리이고 XDG_DATA_HOME이 그걸 가리킨다.
readonly PREFIX="${XDG_DATA_HOME:-$HOME/.local/share}/prefix"
readonly WINE=/app/wine/bin/wine
readonly SERVER=/app/wine/bin/wineserver
readonly SHARE=/app/share/kakaotalk
readonly CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/kakaotalk"
# 바깥이 여기서 뭘 해달라고 말하는 자리. serve_control을 보라.
readonly CONTROL="${XDG_DATA_HOME:-$HOME/.local/share}/control"
readonly APP_ID=io.github.chaotic_ground.KakaoTalk

# 64비트 클라이언트. 카카오는 윈도우용을 셋 배포하는데, 이것이 다운로드
# 페이지가 기존버전이라고 적어둔 것이다. 검색으로 나오는
# app-pc.kakaocdn.net/talk/win32/는 32비트다.
readonly INSTALLER_URL=https://lk.kakaocdn.net/talkpc/talk/win32/x64/KakaoTalk_Setup.exe
readonly INSTALLER="$CACHE/KakaoTalk_Setup_x64.exe"
readonly EXE="$PREFIX/drive_c/Program Files/Kakao/KakaoTalk/KakaoTalk.exe"

# 일부러 비워둔다. Wine의 기본값은 96이고 화면 배율은 이 패키지가 아니라
# 컴포지터의 일이다. winewayland는 네이티브 Wayland 클라이언트라 배율을
# 통보받는다. DPI를 박아둘 만한 경우는 XWayland 경로에서 넘어온 것인데,
# 거기서는 wine이 패널의 실제 픽셀을 받아서 96 DPI 프리픽스가 아주 작게
# 나온다. 여기서는 그 이유가 성립하지 않는다. KAKAOTALK_DPI로 덮을 수
# 있고, 트레이 아이콘 크기도 같은 숫자에 달려 있다.
readonly DPI=${KAKAOTALK_DPI:-}
readonly GRAPHICS=${WINE_GRAPHICS:-wayland}

export WINEPREFIX="$PREFIX"
# LOCPATH는 매니페스트에서 온다. 이 스크립트를 돌리는 셸이 처음부터 그걸
# 갖고 시작하도록. ko_KR.UTF-8을 앱 안에 빌드해 넣는 이유는 런타임이 호스트
# 자신의 언어만 담고 있기 때문이다. 없으면 setlocale이 실패하고 wine은 말
# 없이 C로 떨어진다. 나머지 전부가 망가져 보이게 만드는 조용한 실패다.
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-mscoree,mshtml=}"
export LC_ALL=ko_KR.UTF-8

mode=run
case ${1-} in
  --reinstall) mode=reinstall ;;
  --setup) mode=setup ;;
  --quit) mode=quit ;;
  --show) mode=show ;;
  --menu) mode=menu ;;
  --menu-close) mode=menu-close ;;
  --restart) mode=restart ;;
  "") ;;
  *) echo "usage: ${0##*/} [--reinstall|--setup|--quit|--show|--menu|--menu-close|--restart]" >&2
     exit 2 ;;
esac

step() { echo "==> $*"; }

# 둘 다 wine을 돌리지 않는다. 파일에 단어를 쓰고, 돌고 있는 클라이언트를
# 들고 있는 인스턴스가 그걸 집어간다. 그 우회가 왜 필요한지는
# serve_control에 있다.
#
# 그 파일은 호스트 파일 시스템에 있어서 GNOME 확장과 bin/kakaotalk-restart는
# 직접 쓰고 인스턴스를 아예 띄우지 않는다. 이 두 모드는
# `flatpak run <app> --show`가 보이는 대로 동작하라고 있다.
if [[ $mode == show ]] || [[ $mode == quit ]] || [[ $mode == menu ]] ||
   [[ $mode == menu-close ]]; then
  printf '%s\n' "$mode" >"$CONTROL"
  exit 0
fi

# 돌고 있는 클라이언트에 가라고 하고, 기다리고, 그대로 이어서 하나를
# 띄운다. 이 인스턴스가 새 클라이언트가 된다. 그게 여기서 재시작이
# 가능한 이유다. 샌드박스 안에서는 바깥의 무언가를 시작할 수 없지만,
# desktop 액션은 이미 새 `flatpak run`이다.
if [[ $mode == restart ]]; then
  printf 'quit\n' >"$CONTROL"
  for _ in {1..30}; do
    [[ -f $CONTROL ]] || break
    sleep 1
  done
  # 디스플레이가 붙거나 빠지면 Wine의 모니터 기록이 낡고, 낡은 기록이 앱의
  # 팝업을 화면 아무 데나 던진다. 사람이 그걸 떠올릴 만한 때가 재시작이니
  # 여기서 한다.
  sleep 3
fi

# wine 호출마다 상한을 둔다. 하나가 박히면 wineserver를 붙잡고, 그러면
# 아무것도 시작하지 못한다.
wine() { timeout "${WINE_TIMEOUT:-300}" "$WINE" "$@"; }

# reg.exe는 BOM 없는 파일을 헤더가 뭐라고 하든 CP949로 읽는다. 그래서
# 한국어가 든 것은 BOM 붙은 UTF-16LE여야 한다. 이것들이 reg.exe의 argv가
# 아니라 파일을 거치는 이유다.
import_reg() {
  local file=$1
  wine reg import "$(printf 'Z:%s' "${file//\//\\}")" >/dev/null 2>&1
}

ensure_prefix() {
  [[ -f $PREFIX/system.reg ]] && return 0
  step "creating the prefix"
  mkdir -p "$PREFIX"
  WINE_TIMEOUT=900 wine wineboot -u >/dev/null 2>&1 || true
  "$SERVER" -w
}

install_fonts() {
  local dest="$PREFIX/drive_c/windows/Fonts"
  install -d "$dest"
  install -m644 -t "$dest" "$SHARE"/fonts/*.ttf
  # 파일만 넣어두는 것으로는 부족하다. wine이 스스로 집어가기를 거부해서
  # 이름을 직접 적어준다.
  local key='HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\Fonts'
  wine reg add "$key" /v 'NanumGothic (TrueType)' /d NanumGothic.ttf /t REG_SZ /f >/dev/null 2>&1
  wine reg add "$key" /v 'NanumGothic Bold (TrueType)' /d NanumGothicBold.ttf /t REG_SZ /f >/dev/null 2>&1
  wine reg add "$key" /v 'Noto Emoji (TrueType)' /d NotoEmoji-Regular.ttf /t REG_SZ /f >/dev/null 2>&1
}

apply_korean() {
  step "setting the Korean UI language"
  import_reg "$SHARE/kakaotalk-korean.reg"
}

# 카카오톡은 글꼴을 한국어 face 이름으로 요청한다. 자기 스킨 파일이
# 처음부터 끝까지 맑은 고딕이라고 쓴다. 그래서 라틴 이름으로 건 치환은
# 절대 맞지 않고, 메뉴와 툴팁이 네모로 나온다.
substitute_korean_fonts() {
  step "substituting the Korean face names"
  local staged="$CACHE/korean-fonts.reg"
  {
    printf 'Windows Registry Editor Version 5.00\n\n'
    local key
    for key in 'HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\FontSubstitutes' \
               'HKEY_CURRENT_USER\Software\Wine\Fonts\Replacements'; do
      printf '[%s]\n' "$key"
      local face
      for face in "맑은 고딕" "Malgun Gothic" 굴림 굴림체 돋움 돋움체 바탕 바탕체; do
        printf '"%s"="NanumGothic"\n' "$face"
      done
      printf '\n'
    done
  } | iconv -f UTF-8 -t UTF-16LE | { printf '\xff\xfe'; cat; } >"$staged"
  import_reg "$staged"
  rm -f "$staged"
}

# wine이 자기 창 장식을 그리는 글꼴은 WindowMetrics 아래 LOGFONT 덩어리에
# 이름이 박혀 있고, 전부 Tahoma라고 쓰여 있다. 치환은 거기 닿지 못한다.
# wine이 자기 Tahoma를 들고 있어서 face가 없는 게 아니고, 없어야 치환이
# 끼어든다. 그래서 덩어리 안의 face 이름을 직접 바꿔 쓴다.
rename_chrome_fonts() {
  step "pointing the window metrics fonts at NanumGothic"
  local staged="$CACHE/window-metrics.reg"
  python3 - "$PREFIX/user.reg" "$staged" <<'PY'
import re, struct, sys

src, dest = sys.argv[1], sys.argv[2]
text = open(src, encoding="utf-8", errors="surrogateescape").read()
out = ["Windows Registry Editor Version 5.00", "",
       r"[HKEY_CURRENT_USER\Control Panel\Desktop\WindowMetrics]"]

def read(name):
    m = re.search(r'"%s"=hex:((?:[0-9a-f,\\\s]+?))\n(?=")' % name, text)
    if not m:
        return None
    return bytearray(int(b, 16) for b in
                     re.sub(r"[\\\s]", "", m.group(1)).rstrip(",").split(","))

for name in ("CaptionFont", "SmCaptionFont", "MenuFont",
             "StatusFont", "MessageFont", "IconFont"):
    blob = read(name)
    if blob is None:
        # Wine은 StatusFont를 안 쓰고 내장값으로 떨어진다. 나머지를 다
        # 고친 뒤에도 툴팁이 네모를 유지한 이유가 이것이다. MenuFont가
        # 같은 모양과 크기라 거기서 출발한다.
        blob = read("MenuFont")
    if blob is None:
        continue
    # lfFaceName은 LOGFONTW의 마지막 필드다. 오프셋 28에 UTF-16 32개,
    # 남는 자리는 0.
    face = "NanumGothic"
    blob[28:28 + 64] = struct.pack("<32H", *([ord(c) for c in face] + [0] * (32 - len(face))))
    out.append('"%s"=hex:%s' % (name, ",".join("%02x" % b for b in blob)))

out.append("")
open(dest, "w").write("\n".join(out))
PY
  import_reg "$staged"
  rm -f "$staged"
}

# NanumGothic이 아니라 나눔고딕이다. 폰트 링크는 wine이 실제로 쓰는 패밀리
# 이름으로 걸리는데, NanumGothic.ttf는 두 이름을 다 들고 있고 한국어 쪽이
# 주 이름이다. 두 번째로 오는 쪽이 첫 번째에 대한 치환이 된다.
# create_family가 스스로 그렇게 하고 레지스트리에는 흔적을 남기지 않는다.
# 치환된 이름으로 건 링크는 "SystemLink entry for substituted font,
# ignoring"과 함께 버려진다.
link_fallback_fonts() {
  step "linking the fallback faces"
  local staged="$CACHE/fontlink.reg"
  python3 - "$staged" <<'PY'
import sys

def multi_sz(items):
    data = b"".join(s.encode("utf-16-le") + b"\x00\x00" for s in items) + b"\x00\x00"
    return ",".join("%02x" % b for b in data)

# 한글이 먼저, 이모지가 다음. 링크는 기본 face에 자기 글리프가 없는 문자마다
# 순서대로 훑는다.
#
# NanumGothic을 치환뿐 아니라 링크에도 넣는 이유는, wine이 실제로 갖고 있는
# face는 절대 치환되지 않고 wine 자신의 face 몇몇은 한글이 아예 없기
# 때문이다. 그 모습은 네모가 줄지어 나오는 게 아니다. 그것들의 .notdef가
# 비어 있어서, 글자가 딱 그만큼의 빈 자리로 그려진다. 대화를 스크롤할 때
# 뜨는 날짜가 "2  4"로 나왔다. 월과 일이 빠지고 폭만 남았다.
link = multi_sz(["NanumGothic.ttf,NanumGothic",
                 "NotoEmoji-Regular.ttf,Noto Emoji"])

# 앱이 이름으로 요청할 만하고 wine이 라틴 전용으로 답할 만한 face들.
bases = ("나눔고딕", "맑은 고딕", "Malgun Gothic", "Gulim", "Dotum", "Batang",
         "Arial", "Tahoma", "System", "Segoe UI", "Microsoft Sans Serif",
         "MS Shell Dlg", "MS Shell Dlg 2", "MS Sans Serif", "Helvetica",
         "Verdana", "Courier New", "Times New Roman")

lines = ["Windows Registry Editor Version 5.00", "",
         r"[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\FontLink\SystemLink]"]
for base in bases:
    lines.append('"%s"=hex(7):%s' % (base, link))
lines.append("")
open(sys.argv[1], "w", encoding="utf-16-le").write("﻿" + "\n".join(lines))
PY
  import_reg "$staged"
  rm -f "$staged"
}

# 글꼴 작업은 setup에서 한 번만 하고, setup은 클라이언트가 없을 때만 돈다.
# 그래서 이 내용이 바뀌기 전에 만들어진 프리픽스는 옛 설정을 영영 들고
# 있게 된다. 표시 파일이 어느 설정인지 말해주고, 지금 것이 아니면 단계를
# 다시 돌린다.
#
# install_fonts, substitute_korean_fonts, rename_chrome_fonts,
# link_fallback_fonts가 바뀔 때마다 올린다.
readonly FONTS_VERSION=2

refresh_fonts() {
  local marker="$PREFIX/.fonts-version"
  [[ -f $EXE ]] || return 0
  [[ $(cat "$marker" 2>/dev/null) == "$FONTS_VERSION" ]] && return 0
  install_fonts
  substitute_korean_fonts
  rename_chrome_fonts
  link_fallback_fonts
  printf '%s\n' "$FONTS_VERSION" >"$marker"
}

set_driver_and_dpi() {
  step "pointing wine at the $GRAPHICS driver${DPI:+, at $DPI DPI}"
  wine reg add 'HKEY_CURRENT_USER\Software\Wine\Drivers' \
    /v Graphics /d "$GRAPHICS" /t REG_SZ /f >/dev/null 2>&1
  [[ -n $DPI ]] || return 0
  wine reg add 'HKEY_CURRENT_USER\Control Panel\Desktop' \
    /v LogPixels /d "$DPI" /t REG_DWORD /f >/dev/null 2>&1
}

install_client() {
  if [[ -f $EXE ]] && [[ $mode != reinstall ]]; then
    return
  fi
  if [[ ! -f $INSTALLER ]]; then
    step "downloading the KakaoTalk installer"
    curl -fsSL --create-dirs -o "$INSTALLER" "$INSTALLER_URL"
  fi
  step "running the installer"
  WINE_TIMEOUT=900 wine "$(printf 'Z:%s' "${INSTALLER//\//\\}")" /S >/dev/null 2>&1 || true
  "$SERVER" -w
}

# GNOME이 alt-tab과 오버뷰에 그리는 아이콘. 배포하는 게 아니라 클라이언트
# 에서 꺼낸다. 그림은 카카오의 것이다. Wine이 왜 이걸 못 주는지는
# flatpak/extract-icon.py에 있다.
#
# /app/share/icons가 보통의 자리지만 거기는 아니고 ~/.local/share/icons다.
# 저쪽은 아이콘을 꺼낼 클라이언트가 생기기 한참 전에 읽기 전용이 된다.
# 매니페스트의 --filesystem=xdg-data/icons가 이것 때문에, 이것만을 위해
# 있다.
#
# 실패해도 된다. 아이콘 하나 때문에 시작을 거부할 일은 아니고, 없으면
# 예전과 똑같아 보일 뿐이다.
install_icon() {
  [[ -f $EXE ]] || return 0
  local dir=$HOME/.local/share/icons/hicolor/256x256/apps
  # 한 번이면 되지만 매번 실행할 때 돈다. 이 코드가 있기 전에 설치한
  # 사람은 클라이언트는 있고 아이콘은 없는데, 그들에게 setup()은 다시
  # 돌지 않는다. 다시 만들고 싶으면 파일을 지우면 된다.
  [[ -f $dir/$APP_ID.png ]] && return 0
  step "taking the icon out of the client"
  mkdir -p "$dir" || return 0
  python3 "$SHARE/extract-icon.py" "$EXE" "$dir/$APP_ID.png" || true
  # 이게 없으면 GTK는 캐시가 말한 것을 계속 내놓는다. 전에 없던 이름에
  # 대해서는 아무것도 아니다.
  gtk-update-icon-cache -f -t "$HOME/.local/share/icons/hicolor" >/dev/null 2>&1 || true
}

setup() {
  mkdir -p "$CACHE"
  ensure_prefix
  apply_korean
  install_fonts
  substitute_korean_fonts
  rename_chrome_fonts
  link_fallback_fonts
  set_driver_and_dpi
  install_client
  printf '%s\n' "$FONTS_VERSION" >"$PREFIX/.fonts-version"
}

# 표시는 플래그 파일이 아니라 클라이언트 자신이다. 실행 파일이 있으면
# 프리픽스는 이 모든 단계를 거친 것이고, 없으면 뭔가 잘못된 것이니 다시
# 하는 게 맞다.
if [[ $mode == reinstall ]] || [[ ! -f $EXE ]]; then
  setup
fi

[[ $mode == setup ]] && exit 0

# Wine은 모니터 기록을 들고 있다가, 디스플레이가 붙거나 빠진 뒤 목록에
# 없는 것을 찾아다닌다. "Failed to find monitor with path
# DISPLAY\Default_Monitor\0000&0001"이 그것이고, 그 낡은 기록이 앱의 팝업을
# 화면 아무 데나 던진다. 지우는 데 드는 비용은 없다. wine이 시작하면서 다시
# 만들고 wineboot도 필요 없다.
wine reg delete 'HKLM\System\CurrentControlSet\Enum\DISPLAY' /f >/dev/null 2>&1 || true

refresh_fonts
install_icon

# 돌고 있는 클라이언트에 닿아야 하는 일은 전부 여기, 그것을 시작한
# 인스턴스 안에서 일어나야 한다. 두 번째 `flatpak run`으로는 안 된다.
# 인스턴스마다 PID 네임스페이스가 따로이고, 그 경계를 넘어 다른 프로세스를
# 들여다보는 wine 프로세스는 세션 전체를 데리고 내려간다. 재봤고, 메시지
# 때문이 아니다. 두 번째 인스턴스의 `wine tasklist` 하나로 충분하고,
# 열거만 하는 kakaoshow --list도 마찬가지다. 클라이언트와 explorer가 5초
# 안에 사라지고 로그인을 다시 쳐야 한다.
#
# 그래서 바깥이 파일에 단어를 쓰고 이쪽이 읽는다. fifo가 아니라 평범한
# 파일인 이유는 쓰는 쪽 하나가 GNOME Shell 확장이기 때문이다. fifo를 쓰기로
# 여는 것은 읽는 쪽이 올 때까지 막히는데, gnome-shell에서 그건 바탕화면
# 전체가 멈춘다는 뜻이다.
#
# 0.5초 지연이 생긴다. 창이 돌아오는 데는 느껴지지 않고, 종료에는 아무
# 상관이 없다.
serve_control() {
  rm -f "$CONTROL"
  while sleep 0.5; do
    [[ -f $CONTROL ]] || continue
    local want
    want=$(<"$CONTROL")
    rm -f "$CONTROL"
    case $want in
      # 트레이 아이콘이 하는 일을, 트레이 아이콘 없이. 카카오톡은 최소화가
      # 아니라 숨기기를 하므로 한 번 사라지면 돌아오라고 말을 걸 창이
      # 없다. 실제 트레이 클릭을 +msg로 추적하면 앱이 무엇에 반응하는지
      # 보인다. 자기에게 메시지 하나를 보내고 ShowWindow를 부른다.
      # kakaoshow가 그 메시지를 보낸다. flatpak/kakaoshow.c를 보라.
      show) timeout 60 "$WINE" "$SHARE/kakaoshow.exe" >/dev/null 2>&1 || true ;;
      # 카카오톡 자신의 트레이 메뉴. 여기서 흉내 내는 게 아니라 앱이
      # 직접 띄우므로 항목은 앱이 오늘 갖고 있는 그대로다.
      # flatpak/kakaoshow.c를 보라.
      menu) timeout 60 "$WINE" "$SHARE/kakaoshow.exe" --menu >/dev/null 2>&1 || true ;;
      # 그 메뉴는 스스로 닫히지 않는다. 바탕화면 다른 데를 클릭하면 그건
      # 다른 Wayland 클라이언트에 떨어지고 wine에는 닿지 않으므로, 메뉴는
      # 영영 그 자리에 있게 된다. 확장이 포커스를 잃는 것을 보고 말해준다.
      menu-close) timeout 60 "$WINE" "$SHARE/kakaoshow.exe" --menu-close >/dev/null 2>&1 || true ;;
      # 묻기만 한다. /f 없는 taskkill은 WM_CLOSE를 보내는데, 윈도우 앱이
      # 기대하는 것이고 카카오톡이 세션을 기록할 기회를 준다. 그냥 죽이면
      # 다시 쳐야 하는 로그인이 그 값이다. 카카오톡은 WM_CLOSE를 나가라는
      # 지시가 아니라 "트레이로 숨기기"로 받아들이므로 누군가 뒤이어 고집을
      # 부려야 한다. 그건 바깥에 있는 호출자의 몫이다.
      # bin/kakaotalk-restart를 보라.
      quit) timeout 60 "$WINE" taskkill /im KakaoTalk.exe >/dev/null 2>&1 || true ;;
    esac
  done
}

# exec이 아닌 이유는 이렇다. bwrap은 자기가 시작한 프로세스뿐 아니라
# 샌드박스 안의 모든 것을 기다린다. 그래서 배경에 남겨둔 루프 하나가
# 클라이언트가 간 뒤에도 인스턴스 전체를 붙잡고 있는다. 실제로 그랬다.
# 오전 내내 재시작하고 죽은 샌드박스가 여덟 개 남았는데 각각 안에는 이
# 루프뿐이었고, 그게 충분히 쌓이자 새로 띄운 것은 클라이언트를 아예 갖지
# 못했다.
#
# 그래서 클라이언트를 앞에서 돌리고 루프는 그 뒤에 끝낸다.
serve_control &
readonly CONTROL_PID=$!
trap 'kill "$CONTROL_PID" 2>/dev/null || true; rm -f "$CONTROL"' EXIT INT TERM HUP

"$WINE" "$EXE"

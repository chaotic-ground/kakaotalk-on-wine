#!/bin/bash
# Set the prefix up if it is not, then run KakaoTalk.
#
# Four things have to be Korean before the installer runs, and each fails
# quietly and differently when it is missing: the runtime locale, LC_ALL for
# wine, the Windows UI language in the registry, and a Korean font inside the
# prefix. KakaoTalk reads its UI language once, while installing, so a client
# installed against an English prefix stays English for good.
#
#   kakaotalk              set up if needed, then run
#   kakaotalk --reinstall  install the client again over the top
#   kakaotalk --setup      set up and stop, without running
#   kakaotalk --restart    stop the running client and take its place
#   kakaotalk --quit       ask the running client to close
#   kakaotalk --show       bring the hidden window back
#   kakaotalk --menu       put up the app's own tray menu
#   kakaotalk --menu-close dismiss it
set -euo pipefail
IFS=$'\n\t'

# Not $HOME. Inside the sandbox $HOME is the real path but almost none of it
# is there, and what is written to it does not survive. The app's own data
# directory is what persists, and XDG_DATA_HOME points at it.
readonly PREFIX="${XDG_DATA_HOME:-$HOME/.local/share}/prefix"
readonly WINE=/app/wine/bin/wine
readonly SERVER=/app/wine/bin/wineserver
readonly SHARE=/app/share/kakaotalk
readonly CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/kakaotalk"
# Where the outside asks for something to happen in here. See serve_control.
readonly CONTROL="${XDG_DATA_HOME:-$HOME/.local/share}/control"
readonly APP_ID=io.github.chaotic_ground.KakaoTalk

# The 64-bit client. Kakao publishes three Windows builds; this is the one
# the download page labels 기존버전, and the one every search result hands you
# instead is the 32-bit build at app-pc.kakaocdn.net/talk/win32/.
readonly INSTALLER_URL=https://lk.kakaocdn.net/talkpc/talk/win32/x64/KakaoTalk_Setup.exe
readonly INSTALLER="$CACHE/KakaoTalk_Setup_x64.exe"
readonly EXE="$PREFIX/drive_c/Program Files/Kakao/KakaoTalk/KakaoTalk.exe"

# Unset, and deliberately. Wine's own default is 96 and the scale of the
# screen is the compositor's business, not this package's -- winewayland is a
# native Wayland client and is told. A DPI worth pinning is one carried over
# from the XWayland path, where wine is handed the panel's real pixels and a
# 96 DPI prefix comes out tiny; that reasoning does not hold here. Set
# KAKAOTALK_DPI to override, and note that the tray icon size hangs off the
# same number.
readonly DPI=${KAKAOTALK_DPI:-}
readonly GRAPHICS=${WINE_GRAPHICS:-wayland}

export WINEPREFIX="$PREFIX"
# LOCPATH comes from the manifest, so that the shell running this starts with
# it. ko_KR.UTF-8 is built into the app because the runtime carries only the
# host's own language; without it setlocale fails and wine drops back to C
# without saying so, which is the quiet failure that makes everything else
# look broken.
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-mscoree,mshtml=}"
export LC_ALL=ko_KR.UTF-8

mode=run
case ${1-} in
  --reinstall) mode=reinstall ;;
  --setup) mode=setup ;;
  --quit) mode=quit ;;
  --show) mode=show ;;
  --menu) mode=menu ;;
  --menu-close) mode=menu-close ;;
  --restart) mode=restart ;;
  "") ;;
  *) echo "usage: ${0##*/} [--reinstall|--setup|--quit|--show|--menu|--menu-close|--restart]" >&2
     exit 2 ;;
esac

step() { echo "==> $*"; }

# Neither of these runs wine. They write a word into a file, and the instance
# that owns the running client picks it up -- see serve_control for why that
# indirection has to be there.
#
# The file is on the host filesystem, so the GNOME extension and
# bin/kakaotalk-restart write it directly and never start an instance at all.
# These two exist so that `flatpak run <app> --show` does what it looks like
# it does.
if [[ $mode == show ]] || [[ $mode == quit ]] || [[ $mode == menu ]] ||
   [[ $mode == menu-close ]]; then
  printf '%s\n' "$mode" >"$CONTROL"
  exit 0
fi

# Ask the running client to go, wait for it, then carry on and start one.
# This instance becomes the new client, which is what makes a restart
# possible from in here at all: nothing inside a sandbox can start something
# outside it, but a desktop action is already a fresh `flatpak run`.
if [[ $mode == restart ]]; then
  printf 'quit\n' >"$CONTROL"
  for _ in {1..30}; do
    [[ -f $CONTROL ]] || break
    sleep 1
  done
  # Wine's record of the monitors goes stale when a display comes or goes,
  # and a stale one is what throws the app's own popups across the screen.
  # Restarting is when someone would think to ask, so do it here.
  sleep 3
fi

# Every wine call is capped. One of them wedging holds the wineserver, and
# then nothing can start at all.
wine() { timeout "${WINE_TIMEOUT:-300}" "$WINE" "$@"; }

# reg.exe reads a BOM-less file as CP949 whatever the header claims, so
# anything with Korean in it has to be UTF-16LE with a BOM. That is why these
# go through a file rather than through reg.exe's argv.
import_reg() {
  local file=$1
  wine reg import "$(printf 'Z:%s' "${file//\//\\}")" >/dev/null 2>&1
}

ensure_prefix() {
  [[ -f $PREFIX/system.reg ]] && return 0
  step "creating the prefix"
  mkdir -p "$PREFIX"
  WINE_TIMEOUT=900 wine wineboot -u >/dev/null 2>&1 || true
  "$SERVER" -w
}

install_fonts() {
  local dest="$PREFIX/drive_c/windows/Fonts"
  install -d "$dest"
  install -m644 -t "$dest" "$SHARE"/fonts/*.ttf
  # Dropping the files in is not enough: wine declined to pick them up by
  # itself, so name them outright.
  local key='HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\Fonts'
  wine reg add "$key" /v 'NanumGothic (TrueType)' /d NanumGothic.ttf /t REG_SZ /f >/dev/null 2>&1
  wine reg add "$key" /v 'NanumGothic Bold (TrueType)' /d NanumGothicBold.ttf /t REG_SZ /f >/dev/null 2>&1
  wine reg add "$key" /v 'Noto Emoji (TrueType)' /d NotoEmoji-Regular.ttf /t REG_SZ /f >/dev/null 2>&1
}

apply_korean() {
  step "setting the Korean UI language"
  import_reg "$SHARE/kakaotalk-korean.reg"
}

# KakaoTalk asks for its fonts by Korean face name -- its own skin files name
# 맑은 고딕 throughout -- so Latin-named substitutions never match and menus
# and tooltips come out as boxes.
substitute_korean_fonts() {
  step "substituting the Korean face names"
  local staged="$CACHE/korean-fonts.reg"
  {
    printf 'Windows Registry Editor Version 5.00\n\n'
    local key
    for key in 'HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\FontSubstitutes' \
               'HKEY_CURRENT_USER\Software\Wine\Fonts\Replacements'; do
      printf '[%s]\n' "$key"
      local face
      for face in "맑은 고딕" "Malgun Gothic" 굴림 굴림체 돋움 돋움체 바탕 바탕체; do
        printf '"%s"="NanumGothic"\n' "$face"
      done
      printf '\n'
    done
  } | iconv -f UTF-8 -t UTF-16LE | { printf '\xff\xfe'; cat; } >"$staged"
  import_reg "$staged"
  rm -f "$staged"
}

# The fonts wine draws its own chrome with are named in LOGFONT blobs under
# WindowMetrics and they all say Tahoma. Substitution cannot reach them --
# wine ships its own Tahoma, so the face is not missing and nothing stands in
# -- so the face inside the blob is rewritten instead.
rename_chrome_fonts() {
  step "pointing the window metrics fonts at NanumGothic"
  local staged="$CACHE/window-metrics.reg"
  python3 - "$PREFIX/user.reg" "$staged" <<'PY'
import re, struct, sys

src, dest = sys.argv[1], sys.argv[2]
text = open(src, encoding="utf-8", errors="surrogateescape").read()
out = ["Windows Registry Editor Version 5.00", "",
       r"[HKEY_CURRENT_USER\Control Panel\Desktop\WindowMetrics]"]

def read(name):
    m = re.search(r'"%s"=hex:((?:[0-9a-f,\\\s]+?))\n(?=")' % name, text)
    if not m:
        return None
    return bytearray(int(b, 16) for b in
                     re.sub(r"[\\\s]", "", m.group(1)).rstrip(",").split(","))

for name in ("CaptionFont", "SmCaptionFont", "MenuFont",
             "StatusFont", "MessageFont", "IconFont"):
    blob = read(name)
    if blob is None:
        # Wine leaves StatusFont unwritten and falls back to a built-in,
        # which is how tooltips kept their boxes after the rest were fixed.
        # MenuFont is the same shape and size, so start from it.
        blob = read("MenuFont")
    if blob is None:
        continue
    # lfFaceName is the last field of LOGFONTW: 32 UTF-16 code units at
    # offset 28, null padded.
    face = "NanumGothic"
    blob[28:28 + 64] = struct.pack("<32H", *([ord(c) for c in face] + [0] * (32 - len(face))))
    out.append('"%s"=hex:%s' % (name, ",".join("%02x" % b for b in blob)))

out.append("")
open(dest, "w").write("\n".join(out))
PY
  import_reg "$staged"
  rm -f "$staged"
}

# 나눔고딕 and not NanumGothic. A font link is keyed on the family name wine
# actually uses, and NanumGothic.ttf carries both names with the Korean one
# primary. Whichever comes second becomes a substitution for the first --
# create_family does that itself, with nothing in the registry to show for it
# -- and a link keyed on a substituted name is thrown away with
# "SystemLink entry for substituted font, ignoring".
link_fallback_fonts() {
  step "linking the fallback faces"
  local staged="$CACHE/fontlink.reg"
  python3 - "$staged" <<'PY'
import sys

def multi_sz(items):
    data = b"".join(s.encode("utf-16-le") + b"\x00\x00" for s in items) + b"\x00\x00"
    return ",".join("%02x" % b for b in data)

# Hangul first, then emoji. A link is walked in order, for each character the
# base face has no glyph of its own for.
#
# NanumGothic is in the link and not only in the substitutions because a face
# wine actually has is never substituted, and several of wine's own faces
# carry no Hangul at all. What that looks like is not a row of boxes: their
# .notdef is blank, so the text comes out as the right amount of empty space.
# The date that appears while a conversation is scrolled read "2  4", with
# the 월 and the 일 missing and their widths kept.
link = multi_sz(["NanumGothic.ttf,NanumGothic",
                 "NotoEmoji-Regular.ttf,Noto Emoji"])

# Every face an application is likely to ask for by name and wine is likely
# to answer with something Latin-only.
bases = ("나눔고딕", "맑은 고딕", "Malgun Gothic", "Gulim", "Dotum", "Batang",
         "Arial", "Tahoma", "System", "Segoe UI", "Microsoft Sans Serif",
         "MS Shell Dlg", "MS Shell Dlg 2", "MS Sans Serif", "Helvetica",
         "Verdana", "Courier New", "Times New Roman")

lines = ["Windows Registry Editor Version 5.00", "",
         r"[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\FontLink\SystemLink]"]
for base in bases:
    lines.append('"%s"=hex(7):%s' % (base, link))
lines.append("")
open(sys.argv[1], "w", encoding="utf-16-le").write("﻿" + "\n".join(lines))
PY
  import_reg "$staged"
  rm -f "$staged"
}

# The font work is done once, in setup, and setup runs only when there is no
# client -- so a prefix made before any of it changed would keep the old
# arrangement for good. The marker says which arrangement it has, and the
# steps run again when that is not this one.
#
# Bumped whenever install_fonts, substitute_korean_fonts,
# rename_chrome_fonts or link_fallback_fonts changes.
readonly FONTS_VERSION=2

refresh_fonts() {
  local marker="$PREFIX/.fonts-version"
  [[ -f $EXE ]] || return 0
  [[ $(cat "$marker" 2>/dev/null) == "$FONTS_VERSION" ]] && return 0
  install_fonts
  substitute_korean_fonts
  rename_chrome_fonts
  link_fallback_fonts
  printf '%s\n' "$FONTS_VERSION" >"$marker"
}

set_driver_and_dpi() {
  step "pointing wine at the $GRAPHICS driver${DPI:+, at $DPI DPI}"
  wine reg add 'HKEY_CURRENT_USER\Software\Wine\Drivers' \
    /v Graphics /d "$GRAPHICS" /t REG_SZ /f >/dev/null 2>&1
  [[ -n $DPI ]] || return 0
  wine reg add 'HKEY_CURRENT_USER\Control Panel\Desktop' \
    /v LogPixels /d "$DPI" /t REG_DWORD /f >/dev/null 2>&1
}

install_client() {
  if [[ -f $EXE ]] && [[ $mode != reinstall ]]; then
    return
  fi
  if [[ ! -f $INSTALLER ]]; then
    step "downloading the KakaoTalk installer"
    curl -fsSL --create-dirs -o "$INSTALLER" "$INSTALLER_URL"
  fi
  step "running the installer"
  WINE_TIMEOUT=900 wine "$(printf 'Z:%s' "${INSTALLER//\//\\}")" /S >/dev/null 2>&1 || true
  "$SERVER" -w
}

# The icon GNOME draws in alt-tab and the overview, taken out of the client
# rather than shipped: the picture is Kakao's. See flatpak/extract-icon.py,
# which also says why Wine cannot supply it.
#
# ~/.local/share/icons and not /app/share/icons, which would be the ordinary
# place for it: that one is read-only long before there is a client to take
# an icon from. Hence --filesystem=xdg-data/icons in the manifest, which
# exists for this and nothing else.
#
# Failing is allowed. An icon is not worth refusing to start over, and
# without one the app looks exactly as it did before.
install_icon() {
  [[ -f $EXE ]] || return 0
  local dir=$HOME/.local/share/icons/hicolor/256x256/apps
  # Once is enough, and this runs on every launch: whoever installed before
  # this existed has a client and no icon, and setup() will never run for
  # them again. Delete the file to have it made afresh.
  [[ -f $dir/$APP_ID.png ]] && return 0
  step "taking the icon out of the client"
  mkdir -p "$dir" || return 0
  python3 "$SHARE/extract-icon.py" "$EXE" "$dir/$APP_ID.png" || true
  # Without this GTK keeps serving whatever the cache said, which for a
  # name that was not there before is nothing at all.
  gtk-update-icon-cache -f -t "$HOME/.local/share/icons/hicolor" >/dev/null 2>&1 || true
}

setup() {
  mkdir -p "$CACHE"
  ensure_prefix
  apply_korean
  install_fonts
  substitute_korean_fonts
  rename_chrome_fonts
  link_fallback_fonts
  set_driver_and_dpi
  install_client
  printf '%s\n' "$FONTS_VERSION" >"$PREFIX/.fonts-version"
}

# The marker is the client, not a flag file: if the executable is there the
# prefix has been through all of this, and if it is not then something went
# wrong and doing it again is the right answer.
if [[ $mode == reinstall ]] || [[ ! -f $EXE ]]; then
  setup
fi

[[ $mode == setup ]] && exit 0

# Wine keeps a record of the monitors and goes looking for one that is no
# longer listed after a display comes or goes -- "Failed to find monitor with
# path DISPLAY\Default_Monitor\0000&0001" -- and that stale record is what
# throws the app's own popups across the screen. Dropping it costs nothing:
# wine builds it again as it starts, with no wineboot needed.
wine reg delete 'HKLM\System\CurrentControlSet\Enum\DISPLAY' /f >/dev/null 2>&1 || true

refresh_fonts
install_icon

# Everything that has to reach the client once it is running has to happen in
# here, inside the instance that started it. A second `flatpak run` cannot do
# it: each instance gets its own PID namespace, and a wine process that looks
# at another process across that boundary takes the whole session down with
# it. Measured, and it is not a message that does it -- `wine tasklist` from a
# second instance is enough, and so is kakaoshow --list, which only
# enumerates. The client and its explorer are gone within five seconds, and
# the login has to be typed again.
#
# So the outside writes a word into a file and this reads it. A plain file
# and not a fifo, because one of the writers is a GNOME Shell extension:
# opening a fifo for writing blocks until a reader arrives, and in
# gnome-shell that is the whole desktop stopped.
#
# Half a second of latency, which for a window coming back is not noticeable,
# and for a quit does not matter at all.
serve_control() {
  rm -f "$CONTROL"
  while sleep 0.5; do
    [[ -f $CONTROL ]] || continue
    local want
    want=$(<"$CONTROL")
    rm -f "$CONTROL"
    case $want in
      # What the tray icon is for, without the tray icon. KakaoTalk hides
      # rather than minimises, so once it is away there is no window to ask
      # back, and its own tray menu does not open under the Wayland driver.
      # A +msg trace of a real tray click shows what the app acts on: it
      # posts itself one message and then calls ShowWindow. kakaoshow sends
      # that message. See flatpak/kakaoshow.c.
      show) timeout 60 "$WINE" "$SHARE/kakaoshow.exe" >/dev/null 2>&1 || true ;;
      # KakaoTalk's own tray menu, put up by the app itself rather than
      # imitated out here, so its items are whatever the app has today. It
      # appears at the pointer, which is where the indicator that asked for
      # it is. See flatpak/kakaoshow.c.
      menu) timeout 60 "$WINE" "$SHARE/kakaoshow.exe" --menu >/dev/null 2>&1 || true ;;
      # Nothing dismisses that menu by itself: a click elsewhere on the
      # desktop lands on another Wayland client and never reaches wine, so
      # the menu would sit there for good. The extension watches for it
      # losing the focus and says so.
      menu-close) timeout 60 "$WINE" "$SHARE/kakaoshow.exe" --menu-close >/dev/null 2>&1 || true ;;
      # Asking, and only asking. taskkill without /f sends WM_CLOSE, which is
      # what a Windows app expects and what gives KakaoTalk the chance to
      # write its session out; killing it outright costs a login that has to
      # be typed again. KakaoTalk treats WM_CLOSE as "hide to the tray"
      # rather than as an instruction to leave, so something still has to
      # insist afterwards -- that is the caller's job, from outside. See
      # bin/kakaotalk-restart.
      quit) timeout 60 "$WINE" taskkill /im KakaoTalk.exe >/dev/null 2>&1 || true ;;
    esac
  done
}

# Not exec, and this is why: bwrap waits for everything in the sandbox, not
# only for the process it started, so a loop left running in the background
# holds the whole instance open after the client has gone. That is what
# happened -- eight dead sandboxes after a morning of restarts, each with
# nothing in it but this loop, and with enough of them about a fresh launch
# never got a client at all.
#
# So the client runs in the foreground and the loop is ended after it.
serve_control &
readonly CONTROL_PID=$!
trap 'kill "$CONTROL_PID" 2>/dev/null || true; rm -f "$CONTROL"' EXIT INT TERM HUP

"$WINE" "$EXE"

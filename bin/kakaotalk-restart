#!/bin/bash
# Start, quit or restart KakaoTalk from outside its sandbox.
#
#   --start    start it, unless it is already running
#   --quit     stop it, and insist if asking does not work
#   --recover  restart it, but only if it is still running
#   (nothing)  stop it and start it again
#
# The flatpak's own launcher does most of this from the inside and is the
# better place for it: `kakaotalk --quit`, `--restart`, `--show`. What cannot
# happen in there is insisting -- each flatpak instance has its own PID
# namespace, so nothing inside one can signal a client running in another,
# and an app that treats WM_CLOSE as "hide to the tray" has to be insisted
# with. That is what this is for.
#
# The GNOME extension calls it for --recover, and the desktop entry's guard
# is the other reason it exists: launching the app a second time while it is
# running does not raise the window, it kills the app. A second client starts
# in the same prefix, KakaoTalk is single-instance, and both ends of that
# argument lose.
set -euo pipefail
IFS=$'\n\t'

readonly APP_ID=io.github.chaotic_ground.KakaoTalk

# The file the flatpak's launcher watches. It is under ~/.var/app, which is
# the host's own filesystem, so writing it from out here costs nothing and
# starts nothing.
#
# Which is the point: `flatpak run <app> --quit` would do the same thing, but
# only after starting a second instance, and a second instance is exactly
# what must not happen while the client is up. Each one gets its own PID
# namespace, and a wine process that looks at another process across that
# boundary takes the whole session down with it. See serve_control in
# flatpak/kakaotalk.
# Set while this script is stopping the app, and looked at by --recover.
#
# Closing the tray window is how the extension notices the app has been
# stranded, and a stop closes it too -- so a stop looks exactly like the
# accident it is meant to recover from. It used to be the extension's own
# menu doing the stopping, and it stood itself down; now the stopping happens
# here and out of its sight, so the marker has to be here as well.
#
# Under $XDG_RUNTIME_DIR, which is cleared between logins, so a marker left
# by something that died cannot outlive the session it belonged to.
readonly QUITTING=${XDG_RUNTIME_DIR:-/tmp}/kakaotalk-quitting

ask_app() {
  local control=$HOME/.var/app/$APP_ID/data/control
  [[ -d ${control%/*} ]] || return 1
  printf '%s\n' "$1" >"$control"
}

# Enough of the prefix path to tell this install's processes from anyone
# else's Wine.
readonly PREFIX_HINT=$APP_ID

# pgrep counts a zombie as running. KakaoTalk leaves them behind whenever its
# launcher is killed rather than allowed to reap, and a zombie holds nothing
# but a pid slot -- so treating one as a live process means waiting twenty
# seconds for something already gone, and reading "still running" off a
# corpse.
#
# The brackets are not decoration. ps and grep in a pipeline start together,
# so ps can list the grep itself, and a plain 'KakaoTalk\.exe' has that
# process's own argv to match against -- it reports the app running whenever
# it loses that race. Which is worse than a wrong answer here: --start reads
# it and quietly does nothing, so the app never launches and nothing says
# why. '[K]akaoTalk\.exe' is the same pattern and does not appear in the argv
# of the command carrying it.
running() {
  # shellcheck disable=SC2009  # pgrep is what cannot tell a zombie apart
  ps -eo stat=,args= | grep -a '[K]akaoTalk\.exe' | grep -qav '^Z'
}

# A launch takes the better part of a minute, and for most of it there is no
# window and no KakaoTalk.exe to find -- only the launcher, working. Someone
# watching nothing happen clicks again, and the second client kills the first
# and itself with it, so the wait is not merely wasted, it undoes the launch
# that was already on its way.
# Measured, so that the number means something: a start takes about nine
# seconds from a warm prefix. A launcher older than this is not working, it
# is left over, and treating one as a launch in progress blocks every future
# start for good.
readonly LAUNCH_SECONDS=60

# $1 is a comparison against the launcher's age in seconds, as awk sees it.
#
# The pattern arrives in two halves and is joined in BEGIN for the same reason
# running() spells its name with brackets: ps lists the awk too, and an awk
# invoked with the whole string on its command line matches itself. It would
# then always be a launcher under a minute old, starting() would always be
# true, and --start would never start anything again.
launcher_pids() {
  # shellcheck disable=SC2009  # matching on the full command line, not a name
  ps -eo pid=,etimes=,args= |
    awk -v head='flatpak run' -v tail=" $APP_ID" \
      -v limit="$LAUNCH_SECONDS" \
      -v want="$1" 'BEGIN { pattern = head tail }
        index($0, pattern) &&
        ((want == "young" && $2 < limit) || (want == "old" && $2 >= limit)) { print $1 }'
}

starting() {
  [[ -n $(launcher_pids young) ]]
}

# A launcher with no app under it and no youth to excuse it. Left alone it
# keeps starting() true for good, and every later start is refused.
reap_stale_launchers() {
  running && return 0
  local stale
  stale=$(launcher_pids old)
  [[ -z $stale ]] && return 0
  # -9, because the bwrap wrapper flatpak puts around these sits through a
  # plain TERM. There is no app underneath to shut down gracefully -- that is
  # what makes it stale -- so there is nothing to be careful of.
  echo "$stale" | xargs -r kill -9 2>/dev/null || true
  sleep 1
}

# explorer.exe is a separate process and does not go when the client does, so
# every start and stop used to leave one behind. Each keeps drawing a tray
# window, and they stack up at the same corner of the screen -- four of them
# after a day of testing, two still drawing trays with no client under them.
#
# That is worse than clutter. The indicator raises whichever tray it finds
# first and puts the pointer on it, so a click can land on a tray belonging
# to an instance that is gone; mutter pings it, hears nothing, and puts up
# "explorer.exe is not responding" over a desktop where nothing is wrong.
#
# Scoped by the prefix in the process's own environment rather than by name,
# so a tray belonging to some other Wine prefix is left alone.
reap_tray() {
  # shellcheck disable=SC2009  # matching on the full command line, not a name
  for pid in $(ps -eo pid=,args= | grep -a '[e]xplorer\.exe' | awk '{print $1}'); do
    local env_file=/proc/$pid/environ
    [[ -r $env_file ]] || continue
    if tr '\0' '\n' <"$env_file" 2>/dev/null | grep -q "^WINEPREFIX=.*$PREFIX_HINT"; then
      kill "$pid" 2>/dev/null || true
    fi
  done
}

launch() {
  exec flatpak run "$APP_ID"
}

# The marker is set around the whole of it rather than by a RETURN trap,
# which in bash fires by rules subtle enough to be worth not relying on.
stop() {
  local rc
  : >"$QUITTING"
  stop_now
  rc=$?
  rm -f "$QUITTING"
  return $rc
}

stop_now() {
  # The tray outlives the client. explorer.exe is its own process and nothing
  # ends it when KakaoTalk goes, so a --quit that finds the app already gone
  # still has leftovers to clear -- and leaving them is what stacks trays up
  # at the corner of the screen for the indicator to poke at.
  if ! running; then
    reap_tray
    return 0
  fi

  # Ask before insisting. taskkill without /f sends WM_CLOSE, which is what a
  # Windows app expects and what gives KakaoTalk the chance to write its
  # session out. Killing the process outright does not, and a login that has
  # to be typed again is the visible cost of that.
  #
  # The asking happens inside the sandbox, by way of ask_app, which never
  # starts one; the insisting below happens out here, and has to. A flatpak
  # instance has its own PID namespace, so nothing started inside one can
  # signal a client running in another, wineserver -k included, which works
  # by pid.
  ask_app quit || true

  for _ in {1..15}; do
    if ! running; then
      # It went when asked. The tray did not: explorer.exe is its own
      # process and outlives the client either way, so the reaping belongs
      # after every path out of here, not only after the killing one.
      reap_tray
      return 0
    fi
    sleep 1
  done

  # It did not go. Insist.
  pkill -f 'KakaoTalk\.exe' || true
  reap_tray
  # Wait for the prefix to go quiet. A new instance started while the old
  # wineserver is still winding down tends to exit without a window.
  for _ in {1..20}; do
    running || break
    sleep 1
  done
}

case ${1-} in
  --start)
    reap_stale_launchers
    if running || starting; then
      # Up, or on its way. Doing nothing is not much, but it is better than
      # the alternative, which is killing it.
      exit 0
    fi
    launch
    ;;
  --quit)
    stop
    ;;
  --recover)
    # Called when the tray window goes away. Closing that window strands the
    # app: KakaoTalk hides rather than minimises, so with no tray there is
    # nothing left that can ask it to come back, and no window to ask with.
    #
    # The wait is to tell that apart from an ordinary quit, where the tray
    # window also disappears -- a moment later the process is gone too, and
    # then there is nothing to recover and resurrecting it would be wrong.
    sleep 3
    running || exit 0
    # A stop in progress, which closes the tray window on its way and looks
    # from outside exactly like the thing worth recovering from. Starting the
    # app again here would race the stop and leave both of them dead.
    [[ -f $QUITTING ]] && exit 0
    exec "$0"
    ;;
  "")
    stop
    # Wine's record of the monitors goes stale when a display comes or goes,
    # and a stale one is what throws the app's own popups across the screen.
    # Nothing to do here: the launcher drops that key on every start.
    launch
    ;;
  *)
    echo "usage: ${0##*/} [--start|--quit|--recover]" >&2
    exit 2
    ;;
esac

#!/bin/bash
# Run KakaoTalk with Wine's message tracing on, keeping the last of it.
#
# Written to chase a window that would not come back after the chat list was
# closed and a message arrived, and it is what answered the question. The
# app takes the tray click, posts itself a WM_COMMAND, calls ShowWindow, and
# set_foreground_window succeeds -- none of which reaches the screen, because
# a Wayland client cannot raise itself. Nothing was wrong with the app or
# with Wine; the window was behind everything, drawn correctly, waiting for a
# compositor to raise it.
#
# Kept for the next question of the same shape, where guessing from the
# outside had already produced two confident wrong answers.
#
# No symbols are needed for this, which is the point: the flatpak's Wine is
# stripped, so a backtrace resolves only to module plus offset while +msg
# names every message it prints.
#
# Usage:
#   kakaotalk-trace          start traced, and hold the terminal
#
# There is nothing to undo afterwards. The channels are set with --env on the
# launch, so they last exactly as long as that run.
#
# Leave it running. When the window misbehaves the log is already on disk --
# rewritten every couple of seconds -- so read it then, and take a
# kakaotalk-hang-report alongside it.
#
# Set KAKAOTALK_WINEDEBUG for other channels; +win and +event are the
# neighbours worth reaching for.
set -euo pipefail
IFS=$'\n\t'

readonly APP_ID=io.github.chaotic_ground.KakaoTalk
readonly CHANNELS=${KAKAOTALK_WINEDEBUG:-+timestamp,+msg}
readonly LOG=${KAKAOTALK_TRACE_LOG:-$HOME/kakaotalk-trace.log}

# Lines kept. +msg is a firehose, so this is a ring rather than the whole
# stream: what matters is the end of it, and an unbounded log would fill the
# disk long before anybody read it.
readonly KEEP=${KAKAOTALK_TRACE_LINES:-300000}

readonly REPO="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)"

if [[ -n ${1-} ]]; then
  echo "usage: ${0##*/}" >&2
  exit 2
fi

# Nothing to set and nothing to put back. The manifest pins WINEDEBUG=-all,
# and --env on the launch overrides it for that run only -- so a traced run
# leaves nothing behind, which is the whole of what --off used to undo.
"$REPO/bin/kakaotalk-restart" --quit

echo "WINEDEBUG=$CHANNELS"
echo "keeping the last $KEEP lines in $LOG"
echo "leave this running; Ctrl-C ends the traced run"

flatpak run --env="WINEDEBUG=$CHANNELS" "$APP_ID" 2>&1 |
  python3 -c '
import collections, signal, sys, time

keep, path = int(sys.argv[1]), sys.argv[2]
ring = collections.deque(maxlen=keep)
last = 0.0

def flush():
    with open(path, "w") as out:
        out.write("".join(ring))

# Rewritten on a timer rather than at the end. The interesting moment is
# while the window is still hung and someone is looking at it, and a log that
# only appears once the app is closed is no use for that.
signal.signal(signal.SIGUSR1, lambda *_: flush())
try:
    for line in sys.stdin:
        ring.append(line)
        now = time.monotonic()
        if now - last > 2:
            last = now
            flush()
except KeyboardInterrupt:
    pass
finally:
    flush()
' "$KEEP" "$LOG"
